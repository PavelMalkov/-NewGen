# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/streaming_db"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development

# Stripe (платежи)
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
